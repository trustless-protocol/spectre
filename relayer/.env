# Default sample keys for local development against a Kurtosis ethereum-package
# devnet + the local Cosmos node spun up by scripts/local/run_cosmos_node.sh.
# Replace these with your own keys before any real deployment.

# Kurtosis ethereum-package default prefunded account #1
ETH_PRIVATE_KEY="bcdf20249abf0ed6d944c0288fad489e33f66b3960d9e6229c1cd214ed3bbe31"

# Funded test account on the local Cosmos chain
COSMOS_PRIVATE_KEY="a81f9eb900c02f35d28ec80d1da79dde52cc4cc37d6fbaef5768ab59f32cbfdd"

COSMOS_CHAIN_ID="test-ibc-eth"

# Bech32 account prefix of the target Cosmos chain (e.g. "realio", "osmo").
# Defaults to "cosmos" when unset.
# COSMOS_ADDRESS_PREFIX="cosmos"

# Prover artifact root. The bucket layout expects
# $PROVER_BIN_DIR/n{N}/{r1cs,pk,vk}.bin per bucket. Defaults to ./bin if unset.
PROVER_BIN_DIR="./bin"
